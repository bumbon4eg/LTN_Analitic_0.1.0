```
# ==========================================
# VS Code (Настройки редактора и локальное окружение)
# ==========================================
.vscode/
*.code-workspace

# ==========================================
# Инструкции для ассистентов и генераторов кода
# ==========================================
.github/

# ==========================================
# Временные файлы и артефакты Lua / Busted / LuaRocks
# ==========================================
# Локальные зависимости (если используется LuaRocks)
lua_modules/
.luarocks/

# Временные файлы компиляции
*.o
*.os
*.so
*.dylib
*.dll

# Файлы тестирования и кэша
.busted
.luacov
luacov.stats.out
luacov.report.out
.luacheckrc.cache

# ==========================================
# Специфика Factorio (если разрабатывается мод)
# ==========================================

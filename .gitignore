*.zip

# Логи и сохранения Factorio (если симлинкали папку)
factorio-current.log
factorio-previous.log
template-log-handle.json
saves/

# ==========================================
# Документация проекта
# ==========================================
docs/

# ==========================================
# Системные файлы ОС
# ==========================================

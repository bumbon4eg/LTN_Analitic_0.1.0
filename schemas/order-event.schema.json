{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order-event.schema.json",
  "title": "Order Event",
  "description": "A recorded event in an LTN order lifecycle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "order_id", "action", "from_id", "to_id"],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "description": "Unique event identifier for idempotency."
    },
    "order_id": { "type": "integer", "minimum": 1 },
    "action": {
      "type": "string",
      "enum": ["create", "accept", "error", "reassigned", "complete"]
    },
    "from_id": { "type": ["integer", "null"] },
    "to_id": { "type": ["integer", "null"] }
  }
}
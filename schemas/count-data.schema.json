{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "count-data.schema.json",
  "title": "Typed Count",
  "description": "A typed value with an aggregated numeric count.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "count"],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "number",
      "minimum": 0
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "send-data.schema.json",
  "title": "Collected Send Data",
  "description": "Snapshot returned by buffer.collect_send_data().",
  "type": "object",
  "additionalProperties": false,
  "required": ["tick", "orders", "actions", "trains", "stations"],
  "properties": {
    "tick": { "type": "integer", "minimum": 0 },
    "orders": {
      "type": "array",
      "items": { "$ref": "order.schema.json" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "action.schema.json" }
    },
    "trains": {
      "type": "array",
      "items": { "$ref": "train-data.schema.json" }
    },
    "stations": {
      "type": "array",
      "items": { "$ref": "station-data.schema.json" }
    }
  }
}

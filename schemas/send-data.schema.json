{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "send-data.schema.json",
  "title": "Collected Send Data",
  "description": "Snapshot returned by buffer.collect_send_data().",
  "type": "object",
  "additionalProperties": false,
  "required": ["tick", "active_orders", "order_events", "trains", "stations"],
  "properties": {
    "tick": { "type": "integer", "minimum": 0 },
    "active_orders": {
      "type": "array",
      "items": { "$ref": "order.schema.json" }
    },
    "order_events": {
      "type": "array",
      "items": { "$ref": "order-event.schema.json" }
    },
    "trains": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": { "$ref": "train-data.schema.json" }
      },
      "additionalProperties": false
    },
    "stations": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": { "$ref": "station-data.schema.json" }
      },
      "additionalProperties": false
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "train-data.schema.json",
  "title": "Train Data",
  "description": "A serializable train snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "length", "composition_summary", "fuel", "name", "planet"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "length": { "type": "string", "pattern": "^[0-9]+-[0-9]+-[0-9]+$" },
    "composition_summary": {
      "type": "object",
      "patternProperties": {
        "^.+$": { "$ref": "wagon-summary.schema.json" }
      },
      "additionalProperties": false
    },
    "fuel": {
      "type": "array",
      "items": { "$ref": "count-data.schema.json" }
    },
    "name": { "type": ["string", "null"] },
    "planet": { "type": ["string", "null"] }
  }
}

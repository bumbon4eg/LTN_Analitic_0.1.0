{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "packet.schema.json",
  "title": "LTN Analytic JSONL Packet",
  "description": "One line written by jsonl.lua to script-output/LTN_Analitic/data.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "world_id",
    "sequence",
    "tick",
    "orders",
    "actions",
    "trains",
    "stations"
  ],
  "properties": {
    "protocol_version": {
      "type": "integer",
      "const": 1
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "description": "Persistent UUID v4 identifying the Factorio world."
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "orders": {
      "type": "array",
      "items": { "$ref": "order.schema.json" }
    },
    "actions": {
      "type": "array",
      "items": { "$ref": "action.schema.json" }
    },
    "trains": {
      "type": "array",
      "items": { "$ref": "train-data.schema.json" }
    },
    "stations": {
      "type": "array",
      "items": { "$ref": "station-data.schema.json" }
    }
  }
}

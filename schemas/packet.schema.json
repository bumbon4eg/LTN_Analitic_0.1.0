{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "packet.schema.json",
  "title": "LTN Analytic JSONL Packet",
  "description": "One line written by jsonl.lua to script-output/LTN_Analitic/data.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "world_id",
    "sequence_number",
    "tick",
    "active_orders",
    "order_events",
    "trains",
    "stations"
  ],
  "properties": {
    "protocol_version": {
      "type": "integer",
      "const": 1
    },
    "world_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "description": "Persistent UUID v4 identifying the Factorio world."
    },
    "sequence_number": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing packet sequence number within the world."
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "active_orders": {
      "type": "array",
      "items": { "$ref": "order.schema.json" }
    },
    "order_events": {
      "type": "array",
      "items": { "$ref": "order-event.schema.json" }
    },
    "trains": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": { "$ref": "train-data.schema.json" }
      },
      "additionalProperties": false,
      "description": "Train data indexed by train ID."
    },
    "stations": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": { "$ref": "station-data.schema.json" }
      },
      "additionalProperties": false,
      "description": "Station data indexed by station ID."
    }
  }
}
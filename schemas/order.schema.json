{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order.schema.json",
  "title": "Order",
  "description": "An order created from a new LTN delivery.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "creation_time", "network_id", "train_id", "current_content", "required"],
  "properties": {
    "id": { "type": "integer", "minimum": 1 },
    "creation_time": {
      "type": "integer",
      "minimum": 0,
      "description": "Factorio game tick; convert to a database timestamp at ingestion."
    },
    "network_id": { "type": "integer" },
    "train_id": { "type": "integer", "minimum": 1 },
    "current_content": {
      "type": "array",
      "items": { "$ref": "count-data.schema.json" }
    },
    "required": {
      "type": "array",
      "items": { "$ref": "count-data.schema.json" }
    }
  }
}
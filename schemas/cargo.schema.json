{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cargo.schema.json",
  "title": "Train Cargo",
  "description": "Cargo snapshot keyed by item or fluid name.",
  "type": "object",
  "propertyNames": {
    "pattern": "^(item|fluid),.+$"
  },
  "additionalProperties": {
    "type": "number",
    "minimum": 0
  }
}
